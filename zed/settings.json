{
  "cli_default_open_behavior": "existing_window",
  "base_keymap": "VSCode",
  "vim_mode": true,
  "theme": "Catppuccin Mocha",
  "auto_install_extensions": {
    "catppuccin": true
  },
  "project_panel": {
    "dock": "left",
    "starts_open": true
  },
  "agent": {
    "dock": "left"
  },
  "terminal": {
    "dock": "bottom",
    "working_directory": "current_project_directory"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager"
  },
  "show_edit_predictions": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          }
        }
      }
    }
  }
}
