[
  {
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-space": "workspace::ToggleBottomDock",
      "ctrl-alt-u": "workspace::Unfollow",
      "alt-b": "workspace::ToggleLeftDock",
      "alt-v": "agent::ToggleFocus",
      "alt-e": "project_panel::ToggleFocus",
      "alt-f": "file_finder::Toggle",
      "alt-shift-c": [
        "agent::NewExternalAgentThread",
        { "agent": "codex-acp" }
      ],
      "ctrl-p": "file_finder::Toggle",
      "ctrl-shift-f": "pane::DeploySearch",
      "f12": "editor::GoToDefinition"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "alt-v": "project_panel::ToggleFocus",
      "ctrl-space": "workspace::ToggleBottomDock",
      "ctrl-alt-u": "workspace::Unfollow"
    }
  },
  {
    "context": "AcpThread > Editor",
    "bindings": {
      "ctrl-v": "editor::Paste",
      "ctrl-enter": "agent::Chat",
      "ctrl-alt-u": "workspace::Unfollow"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-space": "workspace::ToggleBottomDock",
      "ctrl-alt-u": "workspace::Unfollow",
      "alt-c": [
        "action::Sequence",
        [
          "agent::AddSelectionToThread",
          "agent::ToggleFocus"
        ]
      ]
    }
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-space": "workspace::ToggleBottomDock",
      "ctrl-alt-u": "workspace::Unfollow",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-space": "workspace::ToggleBottomDock",
      "ctrl-alt-u": "workspace::Unfollow"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-space": "workspace::ToggleBottomDock",
      "ctrl-alt-u": "workspace::Unfollow"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-space": "workspace::ToggleBottomDock",
      "ctrl-alt-u": "workspace::Unfollow"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space f": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "space a": "agent::ToggleFocus",
      "space p": "editor::ToggleEditPrediction"
    }
  }
]
